# Copy this file to .env.local and replace the placeholder values.
# Keep .env.local private; it is ignored by git.

DATABASE_URL=postgresql://clinic_app:change-me@127.0.0.1:5432/family_dental_clinic

# Used to sign the receptionist session cookie. Use at least 32 random characters.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Passcode for /reception/login. Change this before sharing or deploying the app.
RECEPTION_PASSCODE=choose-a-strong-passcode
